DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare_crm"
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Optional for local dev. Leave empty to infer http://localhost:$PORT automatically.
NEXTAUTH_URL=""
# When set, distributed rate limiting uses Redis (INCR/PEXPIRE); otherwise an
# in-memory per-instance store is used. If Redis is unreachable, the limiter
# fails open (requests are allowed) and logs a safe operational error.
REDIS_URL=""
WS_URL=""
# Only set "true" when you intentionally want demo users/data provisioned at
# app/container startup. The Docker stack defaults this to "false".
SEED_DEMO_DATA=""
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# --- Docker Compose (local container stack) ---
# docker-compose.yml has no hardcoded secrets. docker compose reads the project
# .env automatically; set these before running `docker compose up`.
#   NEXTAUTH_SECRET   (above) - required by the web container
#   ENCRYPTION_KEY    (above) - required by the web container
#   POSTGRES_PASSWORD (below) - required by postgres and web containers
#   POSTGRES_USER / POSTGRES_DB - optional, defaults shown below
# Example:
#   openssl rand -hex 32   > NEXTAUTH_SECRET
#   openssl rand -hex 32   > ENCRYPTION_KEY
#   openssl rand -hex 24   > POSTGRES_PASSWORD
# If you change these after first run, recreate volumes with `docker compose down -v`.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-long-random-string"
POSTGRES_DB="healthcare_crm"
FHIR_BASE_URL=""
FHIR_AUTH_TOKEN=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# console (default: logs links to server console), smtp, or resend
EMAIL_PROVIDER="console"
# SMTP (used when EMAIL_PROVIDER=smtp)
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM=""
# Resend (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=""
# Set true to skip Prisma DB init (e.g. CI builds without a database)
SKIP_DB_INIT="false"
