DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare_crm"
# Generate with: openssl rand -hex 32
# Production boot refuses to start if this is missing, shorter than 32 chars, or a placeholder.
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Optional for local dev. Leave empty to infer http://localhost:$PORT automatically.
NEXTAUTH_URL=""
# When set, distributed rate limiting uses Redis (INCR/PEXPIRE); otherwise an
# in-memory per-instance store is used. If Redis is unreachable, the limiter
# fails closed (requests are rejected with 429) and logs a safe operational error.
REDIS_URL=""
# Required in production for unauthenticated cron routes
# (/api/communications/scheduled, /api/communications/appointment-reminders).
# Present as `x-cron-secret` or `Authorization: Bearer` (Vercel Cron style).
# Generate with: openssl rand -hex 32
CRON_SECRET=""
WS_URL=""
# Only set "true" when you intentionally want demo users/data provisioned at
# app/container startup. The Docker stack defaults this to "false".
SEED_DEMO_DATA=""
# Generate with: openssl rand -hex 32
# Production boot refuses to start if this is missing, shorter than 32 chars, or a placeholder.
ENCRYPTION_KEY=""

# --- Docker Compose (local container stack) ---
# docker-compose.yml has no hardcoded secrets. docker compose reads the project
# .env automatically; set these before running `docker compose up`.
#   NEXTAUTH_SECRET   (above) - required by the web container
#   ENCRYPTION_KEY    (above) - required by the web container
#   POSTGRES_PASSWORD (below) - required by postgres and web containers
#   POSTGRES_USER / POSTGRES_DB - optional, defaults shown below
# Example:
#   openssl rand -hex 32   > NEXTAUTH_SECRET
#   openssl rand -hex 32   > ENCRYPTION_KEY
#   openssl rand -hex 24   > POSTGRES_PASSWORD
# If you change these after first run, recreate volumes with `docker compose down -v`.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-long-random-string"
POSTGRES_DB="healthcare_crm"
FHIR_BASE_URL=""
FHIR_AUTH_TOKEN=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# --- AI assistant (scribe / summaries) ---
# AI_PROVIDER = openai | anthropic | none (default none). When "none" or the
# key is missing, /api/ai/* fail closed with { enabled: false } and the UI
# shows a "Not configured" banner instead of failing silently.
AI_PROVIDER="none"
AI_API_KEY=""
# AI_MODEL="" (default gpt-4o-mini / claude-3-5-haiku-latest)
# AI_BASE_URL="" (optional OpenAI-compatible override)
# --- Twilio (SMS / WhatsApp) ---
# Missing SID/token => sendSMS/sendWhatsApp return { success: false,
# error: "Twilio not configured" } and the Communications page shows a banner.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER=""
# console (default: logs links to server console), smtp, or resend
EMAIL_PROVIDER="console"
# SMTP (used when EMAIL_PROVIDER=smtp)
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM=""
# Resend (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=""
# Set true to skip Prisma DB init (e.g. CI builds without a database)
SKIP_DB_INIT="false"

# --- Push notifications ---
# Required for web push. Generate signed P-256 (VAPID) keys with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# --- Media uploads (Cloudinary) ---
# Dashboard → Settings → Product environment credentials.
# Do NOT commit real secrets. If keys were shared in chat, rotate them.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
