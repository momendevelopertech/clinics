generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============== MULTI-TENANT & RBAC ==============
model Organization {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String?               @unique
  phone                String?
  address              String?
  city                 String?
  country              String?
  status               String                @default("active") // pending, active, suspended
  plan                 String                @default("free") // free, clinic, plus
  onboardingSource     String? // self_serve, manual, super_admin
  settingsJson         String? // appointmentDurationMins, openTime, closeTime
  upgradeRequestedPlan String?
  upgradeRequestedAt   DateTime?
  upgradeNote          String?
  timezone             String?               @default("UTC")
  currency             String?               @default("USD")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  users                User[]
  patients             Patient[]
  branches             Branch[]
  appointments         Appointment[]
  encounters           Encounter[]
  tasks                Task[]
  communications       Communication[]
  auditLogs            AuditLog[]
  roles                Role[]
  rooms                Room[]
  equipment            Equipment[]
  invoices             Invoice[]
  insuranceClaims      InsuranceClaim[]
  inventoryItems       InventoryItem[]
  campaigns            Campaign[]
  documents            Document[]
  pricingTiers         PricingTier[]
  waitlistEntries      WaitlistEntry[]
  prescriptions        Prescription[]
  serviceCatalogs      ServiceCatalog[]
  clinicalCatalogs     ClinicalCatalog[]
  patientHistories     PatientHistory[]
  diagnoses            Diagnosis[]
  followUps            FollowUp[]
  labOrders            LabOrder[]
  labResults           LabResult[]
  notifications        Notification[]
  procedureOrders      ProcedureOrder[]
  subscription         Subscription?
  entitlementOverrides EntitlementOverride[]
  pushSubscriptions    PushSubscription[]
  coupons              Coupon[]
  installmentPlans     InstallmentPlan[]
  shifts               Shift[]
  expenses             Expense[]
  clinicalTemplates    ClinicalTemplate[]
  servicePackages      ServicePackage[]
  patientPackages      PatientPackage[]
  treatmentPlans       TreatmentPlan[]
  feedbacks            Feedback[]
  intakeForms          IntakeForm[]
  intakeResponses      IntakeResponse[]
  reportSchedules      ReportSchedule[]
}

// ============== SAAS: PLANS / SUBSCRIPTIONS / ENTITLEMENTS ==============
model Plan {
  id                     String         @id @default(cuid())
  code                   String         @unique // free, clinic, plus, custom...
  internalCode           String?        @unique // short SKU e.g. CLN-001
  nameEn                 String
  nameAr                 String
  descriptionEn          String
  descriptionAr          String
  price                  Decimal        @default(0) @db.Decimal(12, 2)
  billingCycle           String         @default("monthly") // monthly, yearly
  status                 String         @default("active") // active, archived
  displayOrder           Int            @default(0)
  popular                Boolean        @default(false)
  trialDays              Int            @default(0)
  modulesJson            String? // JSON ModuleConfig{ enabled; notes }
  featuresJson           String? // JSON FeatureConfig{ enabled; limit; upgradeMessageKey }
  upgradeTargetId        String?
  upgradeTarget          Plan?          @relation("PlanUpgradePath", fields: [upgradeTargetId], references: [id])
  downgradeTargetIdsJson String?        @default("[]") // JSON array of plan codes
  downgradesAllowed      Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  upgradedFrom           Plan[]         @relation("PlanUpgradePath")
  subscriptions          Subscription[]
}

model Subscription {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id])
  planId             String
  plan               Plan         @relation(fields: [planId], references: [id])
  status             String       @default("active") // trialing, active, past_due, canceled, expired
  currentPeriodStart DateTime     @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean      @default(false)
  canceledAt         DateTime?
  billingCycle       String       @default("monthly")
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([planId])
}

model EntitlementOverride {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  moduleKey      String? // override a module's enabled state
  featureKey     String? // override a feature/limit
  kind           String // module_override | feature_override | limit_override
  valueJson      String? // { enabled } or { limit }
  reason         String?
  createdById    String?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, moduleKey])
  @@index([organizationId, featureKey])
}

model WaitlistEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  preferredDate  DateTime?
  notes          String?
  status         String       @default("waiting") // waiting, offered, cancelled
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
}

model User {
  id                     String             @id @default(cuid())
  organizationId         String
  organization           Organization       @relation(fields: [organizationId], references: [id])
  email                  String             @unique
  name                   String?
  passwordHash           String?
  avatarUrl              String?
  avatarPublicId         String? // Cloudinary public_id for cleanup on replace
  active                 Boolean            @default(true)
  emailVerified          Boolean            @default(false)
  verifyTokenHash        String?
  verifyTokenExp         DateTime?
  resetTokenHash         String?
  resetTokenExp          DateTime?
  specialty              String? // doctor specialty
  licenseNumber          String?
  workingHours           String? // JSON schedule
  branchId               String?
  branch                 Branch?            @relation(fields: [branchId], references: [id])
  roomId                 String?
  room                   Room?              @relation(fields: [roomId], references: [id])
  consultationFee        Decimal?           @db.Decimal(12, 2)
  availabilityType       String? // regular, onCall, byAppointment
  availableDays          String? // JSON array e.g. ["mon","tue","wed"]
  availableFrom          String? // "09:00"
  availableTo            String? // "17:00"
  role                   String? // denormalized: superAdmin, owner, doctor, receptionist
  totpSecret             String? // AES-encrypted TOTP secret (null = 2FA off)
  totpEnabled            Boolean            @default(false)
  totpBackupCodes        String? // JSON array of sha256 hashes (single-use recovery)
  totpEnabledAt          DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  userRoles              UserRole[]
  appointmentsAsProvider Appointment[]      @relation("ProviderAppointments")
  tasksAssigned          Task[]             @relation("AssignedTasks")
  tasksCreated           Task[]             @relation("CreatedTasks")
  auditLogs              AuditLog[]
  encounterNotes         EncounterNote[]
  prescriptions          Prescription[]
  labOrders              LabOrder[]         @relation("LabOrderAuthor")
  reviewedLabResults     LabResult[]        @relation("LabResultReviewer")
  procedureOrders        ProcedureOrder[]   @relation("ProcedureOrderAuthor")
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  shifts                 Shift[]

  @@index([organizationId, active])
}

model Role {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  name           String // Super Admin, Doctor, Nurse, Receptionist, Patient, Biller, Pharmacist
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  permissions    RolePermission[]
  userRoles      UserRole[]
}

model RolePermission {
  id        String   @id @default(cuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  action    String // e.g. patients:read, patients:write, billing:read
  resource  String? // patients, appointments, billing, etc.
  createdAt DateTime @default(now())
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

// ============== PATIENT MANAGEMENT ==============
model Patient {
  id                     String            @id @default(cuid())
  organizationId         String
  organization           Organization      @relation(fields: [organizationId], references: [id])
  mrn                    String? // Medical Record Number (unique per organization)
  firstName              String
  lastName               String
  dateOfBirth            DateTime?
  gender                 String?
  email                  String?
  phone                  String?
  phoneSecondary         String?
  address                String?
  city                   String?
  state                  String?
  zip                    String?
  country                String?
  bloodType              String?
  allergies              String? // JSON array or comma-separated
  primaryCareProvider    String?
  passwordHash           String?
  sensitiveDataEncrypted String?
  emergencyContact       EmergencyContact?
  familyHistory          String? // JSON for genetic/family history
  status                 String            @default("Active") // Active, Inactive, Archived
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  appointments           Appointment[]
  encounters             Encounter[]
  tasks                  Task[]
  communications         Communication[]
  consents               Consent[]
  vitals                 Vital[]
  prescriptions          Prescription[]
  labResults             LabResult[]
  labOrders              LabOrder[]
  procedureOrders        ProcedureOrder[]
  insurancePolicies      InsurancePolicy[]
  invoices               Invoice[]
  documents              Document[]
  waitlistEntries        WaitlistEntry[]
  sessions               PatientSession[]
  histories              PatientHistory[]
  diagnoses              Diagnosis[]
  followUps              FollowUp[]
  insuranceClaims        InsuranceClaim[]
  installmentPlans       InstallmentPlan[]
  patientPackages        PatientPackage[]
  treatmentPlans         TreatmentPlan[]
  feedbacks              Feedback[]
  intakeResponses        IntakeResponse[]

  @@unique([organizationId, mrn])
  @@index([organizationId, status])
  @@index([organizationId, lastName])
  @@index([organizationId, phone])
}

model PatientSession {
  id        String    @id @default(cuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PatientHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  category       String
  title          String
  details        String?
  onsetDate      DateTime?
  resolvedAt     DateTime?
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, patientId, status])
}

model EmergencyContact {
  id                   String  @id @default(cuid())
  patientId            String  @unique
  patient              Patient @relation(fields: [patientId], references: [id])
  name                 String
  relationship         String?
  phone                String
  email                String?
  contactDataEncrypted String?
}

model Consent {
  id             String    @id @default(cuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id])
  organizationId String // Required: tenant scope for all consent queries
  consentType    String // HIPAA, treatment, data_usage
  isGranted      Boolean   @default(true)
  documentUrl    String?
  signedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ============== APPOINTMENT, QUEUE & SCHEDULING ==============
model Branch {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  address        String?
  city           String?
  state          String?
  zip            String?
  country        String?
  phone          String?
  email          String?
  status         String        @default("active") // active, inactive
  workingHours   String? // JSON e.g. {"mon": {"open": "09:00", "close": "17:00"}, ...}
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  rooms          Room[]
  appointments   Appointment[]
  staff          User[]
  shifts         Shift[]
  expenses       Expense[]

  @@index([organizationId, status])
}

model Shift {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  weekday        Int // 0=Sunday … 6=Saturday
  startTime      String // "HH:MM"
  endTime        String // "HH:MM"
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId, weekday])
  @@index([branchId, weekday])
}

model Appointment {
  id                 String                 @id @default(cuid())
  organizationId     String
  organization       Organization           @relation(fields: [organizationId], references: [id])
  branchId           String?
  branch             Branch?                @relation(fields: [branchId], references: [id])
  patientId          String
  patient            Patient                @relation(fields: [patientId], references: [id])
  providerId         String
  provider           User                   @relation("ProviderAppointments", fields: [providerId], references: [id])
  roomId             String?
  room               Room?                  @relation(fields: [roomId], references: [id])
  startTime          DateTime
  endTime            DateTime
  bufferMinutes      Int?                   @default(0)
  appointmentType    String? // consultation, procedure, telehealth, etc.
  telehealthUrl      String? // bring-your-own meeting link (Meet/Zoom) for telehealth visits
  status             String // scheduled, arrived, in_progress, completed, cancelled, no_show
  notes              String?
  tokenNumber        String?
  isWalkIn           Boolean                @default(false)
  cancellationReason String?
  idempotencyKey     String?                @unique // For duplicate prevention
  isRecurring        Boolean                @default(false)
  recurrenceRule     String? // RRULE or custom
  reminder24hSent    Boolean                @default(false)
  reminder1hSent     Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  encounter          Encounter?
  equipmentSlots     AppointmentEquipment[]
  feedbacks          Feedback[]

  @@index([organizationId, startTime])
  @@index([providerId, startTime, status])
  @@index([patientId, startTime])
}

model AppointmentEquipment {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  equipmentId   String
  equipment     Equipment   @relation(fields: [equipmentId], references: [id])
  allocatedAt   DateTime    @default(now())
}

model Room {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  name           String
  number         String? // Room number/identifier
  type           String? // operatory, consultation, procedure
  status         String        @default("active") // active, inactive
  workingHours   String? // JSON
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
  staff          User[]

  @@index([organizationId, status])
}

model Equipment {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id])
  name             String
  type             String? // xray, dialysis, etc.
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  appointmentSlots AppointmentEquipment[]
}

// ============== CLINICAL (EMR/EHR) ==============
model Encounter {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  patientId        String
  patient          Patient           @relation(fields: [patientId], references: [id])
  appointmentId    String?           @unique
  appointment      Appointment?      @relation(fields: [appointmentId], references: [id])
  startTime        DateTime
  endTime          DateTime?
  status           String // in_progress, completed
  encounterType    String? // office_visit, telehealth
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  notes            EncounterNote[]
  vitals           Vital[]
  prescriptions    Prescription[]
  diagnoses        Diagnosis[]
  followUps        FollowUp[]
  labOrders        LabOrder[]
  procedureOrders  ProcedureOrder[]
  invoiceLineItems InvoiceLineItem[]
  treatmentPlans   TreatmentPlan[]

  @@index([organizationId, patientId, startTime])
}

model EncounterNote {
  id          String    @id @default(cuid())
  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  noteType    String    @default("SOAP") // SOAP, freeform
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  text        String? // Fallback for freeform
  templateId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Vital {
  id                     String     @id @default(cuid())
  patientId              String
  patient                Patient    @relation(fields: [patientId], references: [id])
  encounterId            String?
  encounter              Encounter? @relation(fields: [encounterId], references: [id])
  weightKg               Float?
  heightCm               Float?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate              Int?
  bmi                    Float?
  spO2                   Int?
  temperature            Float?
  recordedAt             DateTime   @default(now())
}

model Prescription {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id])
  encounterId    String?
  encounter      Encounter?         @relation(fields: [encounterId], references: [id])
  prescribedById String
  prescriber     User               @relation(fields: [prescribedById], references: [id])
  medicationName String
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?
  status         String             @default("active") // active, completed, cancelled
  idempotencyKey String?            @unique
  sentToPharmacy Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  items          PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  medicationName String
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?
  createdAt      DateTime     @default(now())
}

model Diagnosis {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  encounterId    String?
  encounter      Encounter?   @relation(fields: [encounterId], references: [id])
  system         String
  code           String
  name           String
  notes          String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, patientId, status])
}

model FollowUp {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  encounterId    String?
  encounter      Encounter?   @relation(fields: [encounterId], references: [id])
  dueDate        DateTime
  reason         String
  instructions   String?
  status         String       @default("planned")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, patientId, status, dueDate])
}

model LabResult {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  orderId        String?
  order          LabOrder?    @relation(fields: [orderId], references: [id])
  testName       String
  resultValue    String?
  unit           String?
  referenceRange String?
  status         String // pending, completed, abnormal, reviewed
  performedAt    DateTime?
  reportUrl      String?
  reviewedById   String?
  reviewedBy     User?        @relation("LabResultReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model LabOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  encounterId    String?
  encounter      Encounter?   @relation(fields: [encounterId], references: [id])
  orderedById    String
  orderedBy      User         @relation("LabOrderAuthor", fields: [orderedById], references: [id])
  orderType      String // lab, imaging
  testName       String
  priority       String       @default("routine") // routine, urgent, stat
  indication     String?
  transmittedAt  DateTime?
  externalRef    String?
  status         String       @default("ordered") // ordered, collected, resulted, reviewed, cancelled
  orderedAt      DateTime     @default(now())
  results        LabResult[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, patientId, status])
}

// ============== BILLING & RCM ==============
model Invoice {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  patientId        String
  patient          Patient           @relation(fields: [patientId], references: [id])
  invoiceNumber    String            @unique
  currency         String            @default("USD")
  status           String // draft, sent, partially_paid, paid, overdue
  totalAmount      Decimal           @db.Decimal(12, 2)
  amountPaid       Decimal           @default(0) @db.Decimal(12, 2)
  dueDate          DateTime?
  idempotencyKey   String?           @unique
  couponCode       String?
  orderDiscount    Decimal           @default(0) @db.Decimal(12, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lineItems        InvoiceLineItem[]
  payments         Payment[]
  insuranceClaims  InsuranceClaim[]
  installmentPlans InstallmentPlan[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model InvoiceLineItem {
  id               String          @id @default(cuid())
  invoiceId        String
  invoice          Invoice         @relation(fields: [invoiceId], references: [id])
  serviceCatalogId String?
  serviceCatalog   ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])
  description      String
  quantity         Int             @default(1)
  unitPrice        Decimal         @db.Decimal(12, 2)
  discountAmount   Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal         @default(0) @db.Decimal(12, 2)
  amount           Decimal         @db.Decimal(12, 2)
  cptCode          String?
  createdAt        DateTime        @default(now())
  encounter        Encounter?      @relation(fields: [encounterId], references: [id])
  encounterId      String?
}

model Coupon {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  kind           String // percent | fixed
  value          Decimal      @db.Decimal(12, 2) // percent 0-100 or fixed money amount
  active         Boolean      @default(true)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model InstallmentPlan {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id])
  totalAmount    Decimal       @db.Decimal(12, 2)
  downPayment    Decimal       @default(0) @db.Decimal(12, 2)
  status         String        @default("active") // active, completed, cancelled
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  installments   Installment[]

  @@index([organizationId, status])
  @@index([invoiceId])
}

model Installment {
  id        String          @id @default(cuid())
  planId    String
  plan      InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  amount    Decimal         @db.Decimal(12, 2)
  status    String          @default("pending") // pending, paid, overdue, cancelled
  paidAt    DateTime?
  paymentId String?
  payment   Payment?        @relation(fields: [paymentId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([planId, status])
  @@index([dueDate, status])
}

model Expense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  category       String // rent, salaries, supplies, utilities, marketing, other
  amount         Decimal      @db.Decimal(12, 2)
  spentAt        DateTime     @default(now())
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, spentAt])
  @@index([organizationId, category])
}

model ClinicalTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  specialty      String?
  noteType       String       @default("soap")
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, specialty])
}

model ServicePackage {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  name             String
  serviceCatalogId String?
  serviceCatalog   ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])
  procedureName    String?
  totalSessions    Int
  price            Decimal         @db.Decimal(12, 2)
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  patientPackages  PatientPackage[]

  @@index([organizationId, active])
}

model PatientPackage {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient        @relation(fields: [patientId], references: [id])
  packageId      String
  package        ServicePackage @relation(fields: [packageId], references: [id])
  sessionsTotal  Int
  sessionsUsed   Int            @default(0)
  status         String         @default("active") // active, completed, cancelled
  pricePaid      Decimal?       @db.Decimal(12, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, patientId, status])
  @@index([packageId, status])
}

model TreatmentPlan {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient             @relation(fields: [patientId], references: [id])
  encounterId    String?
  encounter      Encounter?          @relation(fields: [encounterId], references: [id])
  title          String
  notes          String?
  status         String              @default("draft") // draft, active, completed, cancelled
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  steps          TreatmentPlanStep[]

  @@index([organizationId, patientId, status])
}

model TreatmentPlanStep {
  id        String        @id @default(cuid())
  planId    String
  plan      TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  kind      String // diagnosis, prescription, procedure, followup, note
  refId     String?
  title     String
  dueDate   DateTime?
  status    String        @default("pending") // pending, done, skipped
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([planId, status])
}

model Feedback {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient     @relation(fields: [patientId], references: [id])
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  providerId     String?
  rating         Int // 1-5
  comment        String?
  source         String        @default("portal") // portal, staff, auto
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([providerId, rating])
}

model IntakeForm {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  fields         IntakeField[]
  responses      IntakeResponse[]

  @@index([organizationId, active])
}

model IntakeField {
  id        String     @id @default(cuid())
  formId    String
  form      IntakeForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  key       String
  label     String
  labelAr   String?
  kind      String     @default("text") // text, multiline, number, date, boolean, choice
  required  Boolean    @default(false)
  options   String? // JSON array for choice kind
  position  Int        @default(0)
  createdAt DateTime   @default(now())

  @@unique([formId, key])
  @@index([formId, position])
}

model IntakeResponse {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  formId         String
  form           IntakeForm   @relation(fields: [formId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  appointmentId  String?
  answers        String // JSON object key -> value
  createdAt      DateTime     @default(now())

  @@index([organizationId, formId])
  @@index([patientId, formId])
}

model ReportSchedule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  frequency      String       @default("monthly")
  dayOfMonth     Int          @default(1)
  recipients     String // JSON array of user ids (org staff)
  active         Boolean      @default(true)
  lastSentAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([active, frequency])
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   String // card, cash, insurance, check
  stripePaymentId String?
  status          String // pending, completed, failed, refunded
  refundedAmount  Decimal       @default(0) @db.Decimal(12, 2)
  installments    Installment[]
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())
}

model InsurancePolicy {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  provider     String
  policyNumber String
  groupNumber  String?
  type         String // primary, secondary
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InsuranceClaim {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String?
  patient        Patient?     @relation(fields: [patientId], references: [id])
  invoiceId      String?
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id])
  claimNumber    String?
  status         String // submitted, pending, paid, denied, appeal
  amountClaimed  Decimal?     @db.Decimal(12, 2)
  amountPaid     Decimal?     @db.Decimal(12, 2)
  denialReason   String?
  submittedAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([patientId])
  @@index([invoiceId])
}

model PricingTier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  createdAt      DateTime     @default(now())
}

model ServiceCatalog {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  code             String
  name             String
  description      String?
  category         String?
  durationMins     Int?
  price            Decimal           @db.Decimal(12, 2)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  procedureOrders  ProcedureOrder[]
  invoiceLineItems InvoiceLineItem[]
  servicePackages  ServicePackage[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model ClinicalCatalog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  system         String
  code           String
  name           String
  category       String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, system, code])
  @@index([organizationId, category, active])
}

// ============== PHARMACY & INVENTORY ==============
model InventoryItem {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id])
  name           String
  sku            String?
  category       String? // medication, consumable, device
  quantity       Int                    @default(0)
  reorderLevel   Int?
  unit           String?                @default("each")
  expiryDate     DateTime?
  batchNumber    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  transactions   InventoryTransaction[]

  @@index([organizationId, expiryDate])
}

model InventoryTransaction {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id])
  type      String // restock, usage, adjustment
  quantity  Int
  reason    String?
  createdAt DateTime      @default(now())
}

// ============== COMMUNICATIONS & ENGAGEMENT ==============
model Communication {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  channel        String // sms, email, whatsapp
  type           String // reminder, campaign, notification
  status         String // pending, sent, delivered, failed
  content        String
  scheduledFor   DateTime?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, scheduledFor])
}

model Campaign {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  type           String // drip, broadcast
  status         String       @default("draft")
  triggerType    String? // post_visit, chronic_care
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model FeedbackSurvey {
  id          String    @id @default(cuid())
  patientId   String?
  encounterId String?
  npsScore    Int?
  feedback    String?
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
}

// ============== TASKS & TICKETING ==============
model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  description    String?
  status         String // open, in_progress, completed, cancelled
  priority       String? // low, medium, high, urgent
  dueDate        DateTime?
  patientId      String?
  patient        Patient?     @relation(fields: [patientId], references: [id])
  assigneeId     String?
  assignee       User?        @relation("AssignedTasks", fields: [assigneeId], references: [id])
  creatorId      String
  creator        User         @relation("CreatedTasks", fields: [creatorId], references: [id])
  taskType       String? // follow_up, lab_review, claim_followup
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, dueDate])
  @@index([assigneeId, status])
}

// ============== DOCUMENTS & COMPLIANCE ==============
model Document {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  patientId        String
  patient          Patient         @relation(fields: [patientId], references: [id])
  procedureOrderId String?
  procedureOrder   ProcedureOrder? @relation(fields: [procedureOrderId], references: [id])
  name             String
  type             String // imaging, lab_report, consent, id
  storageKey       String // Server-issued Cloudinary URL (never client-supplied)
  publicId         String? // Cloudinary public_id for cleanup
  mimeType         String?
  createdAt        DateTime        @default(now())

  @@index([organizationId, patientId])
  @@index([organizationId, createdAt])
}

model ProcedureOrder {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  patientId        String
  patient          Patient         @relation(fields: [patientId], references: [id])
  encounterId      String?
  encounter        Encounter?      @relation(fields: [encounterId], references: [id])
  orderedById      String
  orderedBy        User            @relation("ProcedureOrderAuthor", fields: [orderedById], references: [id])
  serviceCatalogId String?
  serviceCatalog   ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])
  procedureName    String
  status           String          @default("ordered")
  scheduledAt      DateTime?
  notes            String?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  documents        Document[]

  @@index([organizationId, patientId, status])
}

// ============== AUDIT (Append-Only) ==============
model AuditLog {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  userId          String?
  user            User?        @relation(fields: [userId], references: [id])
  actorType       String       @default("user") // user, patient, system, webhook
  actorIdentifier String?
  action          String // CREATE, UPDATE, DELETE
  entityType      String
  entityId        String
  beforeState     String? // JSON of state before change
  afterState      String? // JSON of state after change
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  recipientId    String
  recipient      User         @relation(fields: [recipientId], references: [id])
  channel        String       @default("in_app")
  title          String
  body           String
  entityType     String?
  entityId       String?
  status         String       @default("unread")
  deliveredAt    DateTime?
  readAt         DateTime?
  failureReason  String?
  createdAt      DateTime     @default(now())

  @@index([recipientId, status, createdAt])
}

// ============== PWA: PUSH NOTIFICATIONS ==============
model PushSubscription {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  endpoint       String
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([endpoint, userId])
  @@index([userId])
  @@index([organizationId])
}
